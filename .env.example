# Postgres connection string. The app writes to a dedicated `syllabus_v2`
# schema so it can share a database with other projects safely.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&schema=syllabus_v2"

# OpenAI key used for structured syllabus extraction.
# Leave blank to run the app in mock extraction mode (no network, no spend).
OPENAI_API_KEY=

# Model used for extraction. Must support structured outputs / json_schema.
OPENAI_MODEL=gpt-4o-2024-08-06

# Set to "true" to force the deterministic mock extractor even if a key is set.
# Useful for demos and for the test suite.
MOCK_AI=false

# Secret used to sign the session cookie. Any long random string.
AUTH_SECRET=change-me-to-a-long-random-string

# Opt-in OCR for scanned PDFs. Off by default: tesseract.js pulls ~30MB of
# WASM and takes 30s+ per page, which would block the upload request.
ENABLE_OCR=false
